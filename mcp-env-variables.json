{
  "environment_variables": {
    "PROMPTS_PATH": {
      "purpose": "Custom prompt directories",
      "default": "~/.aws/amazonq/prompts",
      "example": "/path1:/path2"
    },
    "MCP_LOG_LEVEL": {
      "purpose": "Set logging level",
      "default": "WARNING",
      "values": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
    },
    "MCP_DEBUG_LOGGING": {
      "purpose": "Enable comprehensive debug logging",
      "default": "disabled",
      "values": ["1", "true", "yes", "on"]
    },
    "MCP_LOG_FILE": {
      "purpose": "Custom debug log file path",
      "default": "/tmp/mcp_server_debug.log",
      "example": "/custom/path/debug.log"
    }
  }
}
