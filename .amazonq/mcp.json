{
  "mcpServers": {
    "prompt-server": {
      "command": "uvx",
      "args": ["prompt-mcp-server@latest"],
      "env": {
        "PROMPTS_PATH": "~/.aws/amazonq/prompts",
        "MCP_DEBUG_LOGGING": "true",
        "MCP_LOG_LEVEL": "DEBUG",
        "MCP_LOG_FILE": "/tmp/mcp_server_debug.log"
      },
      "timeout": 30000
    }
  }
}